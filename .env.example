# Supabase 프로젝트 설정 (Supabase Dashboard > Project Settings > API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 절대 클라이언트로 노출되면 안 되는 키. 서버 전용.
SUPABASE_SERVICE_ROLE_KEY=

# 관리자(/admin) 로그인 비밀번호
ADMIN_PASSWORD=7890

# 현장 TV(/) Staff 인증용 비밀번호 (행사 시작 시 1회 입력, 이후 쿠키로 유지)
STAFF_PASSWORD=0000

# 세션 쿠키 서명용 랜덤 문자열 (openssl rand -hex 32 등으로 생성)
SESSION_SECRET=change-this-to-a-long-random-string
